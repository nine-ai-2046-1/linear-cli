{
  "name": "@nineai/linear-cli",
  "version": "0.1.0",
  "description": "Agent-ready Linear CLI with strict per-folder authentication built on @linear/sdk",
  "type": "module",
  "bin": {
    "linear": "./dist/bin/linear.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/bin/linear.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@linear/sdk": "104.0.0",
    "commander": "^14.0.0",
    "graphql": "^16.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "5.9.3",
    "vitest": "^5.1.1"
  }
}
